# Copy to .env and fill in your own AgentCore proxy key.
TYPESAFE_API_KEY=replace-with-your-key
TYPESAFE_BASE_URL=https://jxa-url.eu-central-1.on.aws
TYPESAFE_DEFAULT_MODEL=system-one-v1

# Public demo only: shared Upstash Redis counters (never browser/public envs).
# Vercel Marketplace may supply KV_REST_API_URL / KV_REST_API_TOKEN instead.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-redis-token
# JEV_QUOTA_SECRET=generate-a-stable-random-secret-of-at-least-32-characters
